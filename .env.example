# ================= IA (Groq) =================
LLM_PROVIDER=groq
GROQ_API_KEY=pegá_acá_tu_clave_de_groq
# Modelo principal y de respaldo (llama-3.3-70b-versatile fue retirado por Groq)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Modelo rápido para la memoria (resúmenes y extracción de datos)
GROQ_SMALL_MODEL=openai/gpt-oss-20b
# low | medium | high
GROQ_REASONING_EFFORT=medium
LLM_TEMPERATURE=0.35
LLM_MAX_TOKENS=6000

# Opcional: Gemini como alternativa (LLM_PROVIDER=gemini + pip install google-genai)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# ================= Acceso web =================
# Si se define, la web pide contraseña (recomendado al publicarla en internet)
APP_PASSWORD=
# Cadena larga y aleatoria para firmar la sesión
SECRET_KEY=

# ================= Memoria en la nube (Supabase) =================
# Si se completan las tres, la memoria se guarda en Supabase (necesario en Vercel).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=sb_publishable_...
# ECYD_DB_SECRET=

# ================= Memoria local =================
# Base SQLite con equipos, memoria e historial. En la nube: ruta en un volumen persistente.
# DB_PATH=data/memoria.db
AUTO_MEMORY=true
HISTORY_MESSAGES=8

# ================= RAG (valores por defecto recomendados) =================
# RAG_TOP_K_DOCUMENTS=8
# RAG_CHUNK_CANDIDATES=80
# RAG_TOP_K_CHUNKS=8
# RAG_MAX_CHUNKS_PER_DOC=3
# RAG_MAX_CONTEXT_CHARS=12000
# RAG_MIN_RELEVANCE=0.30
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
